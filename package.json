{
  "name": "bike-nav",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tunnel": "vite --mode tunnel",
    "build": "tsc --noEmit && tsc -p tsconfig.worker.json && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "deploy:stats": "wrangler deploy -c wrangler.stats.jsonc",
    "vapid": "node scripts/vapid.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet-rotate": "^0.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.166.0"
  }
}
