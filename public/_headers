# Response headers for the site (Cloudflare Pages reads this file; it is not served).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# The usage dashboard: not for search engines.
/analytics
  X-Robots-Tag: noindex, nofollow
/analytics.html
  X-Robots-Tag: noindex, nofollow

# The service worker must be re-checked on every visit so fixes reach phones quickly.
/sw.js
  Cache-Control: no-cache
